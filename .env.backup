# Stable Backup Environment Manifest (SAFE COPY)
# Date: 2026-07-27
# Purpose: Disaster recovery reference without exposing raw secrets in git.
# IMPORTANT: Put actual secret values only in your secret manager / provider env vars.

# ===== Frontend / Flutter Defines =====
RENDER_COMPRESSION_API_URL=https://jobready-india.onrender.com
BANK_API_KEY_REF=BANK_API_KEY_SERVER_ONLY
ADS_API_KEY_REF=ADS_API_KEY_SERVER_ONLY
OWNER_ACCESS_CODE=__SET_IN_CI_OR_BUILD_DEFINE__
BENCHMARK_MODE=__OPTIONAL__
BENCHMARK_GATE_POLICY=__OPTIONAL__

# ===== Backend / Render Runtime =====
PORT=5000
BANK_API_KEY=__SECRET_SET_IN_RENDER_ONLY__
ADS_API_KEY=__SECRET_SET_IN_RENDER_ONLY__
GHOSTSCRIPT_BIN=__OPTIONAL_PATH__
GOOGLE_OAUTH_CLIENT_ID=__SET_IN_RENDER__ (Google Cloud OAuth Web Client ID; not a secret, but must match the
  same value passed to the Flutter build via --dart-define=GOOGLE_OAUTH_CLIENT_ID=... so token audience
  verification in /api/user/google-signin succeeds.)
PERSISTENT_DATA_DIR=__SET_IN_RENDER__ (mounted persistent disk path, e.g. /var/data, so sales-transactions-state.json
  and user-accounts-state.json survive redeploys/cold restarts.)

# ===== Optional Security Allow-Lists =====
BANK_API_ALLOWED_IPS=__OPTIONAL__
ADS_API_ALLOWED_IPS=__OPTIONAL__
BANK_API_ALLOWED_REGIONS=IN,SG
ADS_API_ALLOWED_REGIONS=IN,SG

# ===== Deployment References =====
RENDER_SERVICE_URL=https://jobready-india.onrender.com
GITHUB_PAGES_URL=https://getreadyjob.com

# ===== Recovery Notes =====
# 1) Actual keys are maintained in hosting provider secret env variables.
# 2) Local key source file (if used): lib/.env.api-keys.local (do not share publicly).
# 3) Rotate all sensitive keys after any suspected leak.
