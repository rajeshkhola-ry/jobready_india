services:
  - type: static
    name: getreadyjob-frontend
    env: static
    staticPublishPath: build/web
    buildCommand: |
      echo "Using prebuilt Flutter web assets from build/web"
      test -d build/web || { echo "Expected build/web directory is missing"; exit 1; }
    autoDeploy: true
    routes:
      - type: rewrite
        source: /*
        destination: /index.html

  - type: web
    name: getreadyjob-api
    env: python
    plan: free
    rootDir: render_api
    buildCommand: pip install -r requirements.txt
    startCommand: gunicorn app:app
    healthCheckPath: /healthz
    autoDeploy: true

