# Server-side only API key references (do not place real secrets in client code)
# Rotate these values in provider dashboards and backend secret manager.
BANK_API_KEY_REF=BANK_API_KEY_SERVER_ONLY
ADS_API_KEY_REF=ADS_API_KEY_SERVER_ONLY

# Backend runtime secrets (set in hosting provider env vars, not in repository)
BANK_API_KEY=
ADS_API_KEY=

# Optional monitoring allow-lists
BANK_API_ALLOWED_IPS=203.0.113.10,203.0.113.11
ADS_API_ALLOWED_IPS=203.0.113.10,203.0.113.11
BANK_API_ALLOWED_REGIONS=IN,SG
ADS_API_ALLOWED_REGIONS=IN,SG
